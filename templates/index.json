        "product": "thock-model-65",
        "eyebrow": "Model 65 \u2014 gasket mount",
        "heading": "Hear the difference",
        "lead": "A 65% board machined from one billet of aluminium, tuned across five layers of foam until it stopped sounding like a keyboard and started sounding like a full stop.",
        "button_label": "Add to cart",
        "reassurance": "Free shipping over $150 \u00b7 2-year warranty \u00b7 Ships in 3 days",
        "colorway_option_name": "Colorway",
        "switch_option_name": "Switch",
        "min_height": 100,
        "quality": "auto",
        "show_scroll_cue": true,
        "scroll_cue_label": "Scroll to take it apart",
        "use_model": true
      }
